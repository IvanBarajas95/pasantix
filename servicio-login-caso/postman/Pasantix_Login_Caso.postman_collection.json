{
  "info": {
    "_postman_id": "e640ea84-f6de-48c5-b80d-5d7638cbb906",
    "name": "Pasantix - Servicio web Login (Caso AA5)",
    "description": "Pruebas del servicio web de registro e inicio de sesión. Evidencias GA7-220501096-AA5-EV01 / EV02. Autor: Iván Antonio Ovalle Barajas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Verificar servicio",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Responde JSON en menos de 2 s\", () => { pm.response.to.be.json; pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "pm.test(\"Mensaje: funcionando\", () => pm.expect(pm.response.json().mensaje).to.include(\"funcionando\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Registro exitoso",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"MiClave2026*\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"usuarioPrueba\", \"aprendiz_\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Responde JSON en menos de 2 s\", () => { pm.response.to.be.json; pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "pm.test(\"Mensaje: Registro exitoso\", () => pm.expect(pm.response.json().mensaje).to.include(\"Registro exitoso\"));",
              "pm.test(\"Devuelve el usuario creado\", () => pm.expect(pm.response.json().datos.usuario).to.eql(pm.collectionVariables.get(\"usuarioPrueba\")));",
              "pm.test(\"No devuelve la contraseña\", () => pm.expect(pm.response.text()).to.not.include(\"contrasena_hash\"));"
            ]
          }
        }
      ]
    },
